# Copy to .env and fill in. Never commit .env or secrets/.
SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workboard
TIME_ZONE=Europe/Brussels

# Shown in the UI and in Claude's prompt
WORKBOARD_COMPANY_NAME=Scrollit
WORKBOARD_USER_NAME=Jasper
IDLE_AFTER_DAYS=3
AGENT_RUN_TIMEOUT_MIN=15
AUTO_TRIAGE=true

# Odoo 19+ JSON-2 API. Create an API key under Preferences > Account Security.
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_API_KEY=
ODOO_LOGIN=you@yourcompany.com
# helpdesk.team id that misrouted support mails should go to
ODOO_SUPPORT_TEAM_ID=

# Gmail: OAuth "Desktop app" client from Google Cloud console, then `make gmail-auth`
GMAIL_CREDENTIALS_FILE=secrets/gmail_client.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json
GMAIL_QUERY=in:inbox -category:promotions -category:social newer_than:14d
GMAIL_MAX_THREADS=50

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TURNS=8

# Shared skills repo (e.g. scrollit/claude-skills). Cloned and pulled fast-forward only.
SKILLS_REPO_NAME=Scrollit Skills
SKILLS_REPO_URL=https://github.com/scrollit/claude-skills
SKILLS_REPO_PATH=var/skills
# Empty = the remote's default branch (scrollit/claude-skills uses master)
SKILLS_REPO_BRANCH=
